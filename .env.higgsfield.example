# Higgsfield Cloud — configurar apenas no ambiente da Edge Function/Supabase.
# Nunca coloque estes valores em VITE_* nem no frontend.
HF_API_KEY_ID=your-higgsfield-api-key-id
HF_API_KEY_SECRET=your-higgsfield-api-key-secret

# Alternativa para várias chaves. Deve ser JSON numa única linha:
# HF_API_KEYS=[{"id":"key-id-1","secret":"key-secret-1"},{"id":"key-id-2","secret":"key-secret-2"}]
